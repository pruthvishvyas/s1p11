def _kpis(df, config):
    H = config['BASELINE_WINDOW_WEEKS']
    a, b = df.tail(H), df.iloc[-2 * H:-H]

    def entry(key, label, v, pv, unit, period):
        ch = ((v - pv) / abs(pv) * 100) if (pv is not None and pv != 0) else None
