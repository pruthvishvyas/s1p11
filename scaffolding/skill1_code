def md(text):
    return {'cell_type': 'markdown', 'metadata': {}, 'source': text.splitlines(keepends=True)}


def code(text):
    return {'cell_type': 'code', 'execution_count': None, 'metadata': {}, 'outputs': [], 'source': text.splitlines(keepends=True)}


def manifest(done):
    rows = ['| Phase | File | Status |', '|-------|------|--------|']
    for n, f in MANIFEST_ROWS:
        rows.append(f"| {n} | {f} | {'✅' if n in done else '⬜'} |")
    return ("## Notebook Manifest — D2C Weekly Growth & Profit Pipeline\n\n" + '\n'.join(rows) +
            "\n\nRun top to bottom. Every module is written once with %%writefile, then imported and validated in the next cell.\n")


def build_cells():
    cells = [md(manifest(set())), code(SETUP)]
    for n, key in enumerate(ORDER):
        title = PATHS[key]
        cells.append(md(f"### Phase {n} — `{title}`"))
        cells.append(code(f"%%writefile {title}\n" + SOURCES[key]))
        cells.append(code(VALIDATE[key]))
    final = """# FINAL CHECK: all 15 files exist
files = %s
missing = [f for f in files if not os.path.exists(f)]
for f in files: print('✅' if os.path.exists(f) else '❌', f)
assert not missing, f'Missing files: {missing}'
print('\\nAll files generated. Next: python main.py | python report.py | python app.py')""" % repr([PATHS[k] for k in ORDER])
    cells.append(code(final))
    return cells


def write_notebook(path):
    nb = {'cells': build_cells(),
          'metadata': {'kernelspec': {'display_name': 'Python 3', 'language': 'python', 'name': 'python3'},
                       'language_info': {'name': 'python'}},
          'nbformat': 4, 'nbformat_minor': 4}
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(nb, f, indent=1, ensure_ascii=False)
    return path


def extract(nb_path):
    with open(nb_path, encoding='utf-8') as f:
        nb = json.load(f)
    n = 0
    for cell in nb['cells']:
        src = cell.get('source', [])
        if cell['cell_type'] == 'code' and src:
            m = re.match(r'^%%writefile\s+(.+)', src[0].strip())
            if m:
                p = m.group(1).strip()
                if os.path.dirname(p):
                    os.makedirs(os.path.dirname(p), exist_ok=True)
                with open(p, 'w', encoding='utf-8') as out:
                    out.write(''.join(src[1:]))
                n += 1
    return n


