        lo, hi = q1 - 1.5 * iqr, q3 + 1.5 * iqr
        n_out = int(((df[c] < lo) | (df[c] > hi)).sum())
        df[c] = df[c].clip(lo, hi)
        capped[c] = {'capped_rows': n_out, 'lower': round(float(lo), 4), 'upper': round(float(hi), 4)}
